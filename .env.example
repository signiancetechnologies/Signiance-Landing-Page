# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Never commit real values.

# From the sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Tab (worksheet) name to append rows to. Defaults to "Sheet1".
GOOGLE_SHEET_TAB=Sheet1

# "client_email" from the service-account JSON key.
# Share the sheet with this address as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# "private_key" from the JSON key, copied exactly, inside double quotes
# (the \n sequences are fine; the app converts them to newlines).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
